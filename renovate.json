{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "schedule": ["before 6am on monday"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.snipe-it-version$/"],
      "matchStrings": ["^(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\s*$"],
      "depNameTemplate": "grokability/snipe-it",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?<version>v\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "ARG SNIPE_IT_VERSION=(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "grokability/snipe-it",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?<version>v\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "ARG SUPERCRONIC_VERSION=(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "aptible/supercronic",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?<version>v\\d+\\.\\d+\\.\\d+)$"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["grokability/snipe-it"],
      "commitMessageTopic": "Snipe-IT",
      "labels": ["snipe-it-bump"],
      "automerge": false
    },
    {
      "matchManagers": ["github-actions"],
      "labels": ["github-actions"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ]
}
