{
  "verbose": true,
  "logging": [
    { "type": "json", "target": "/backups/phpbu.log" },
    {
      "type": "mail",
      "options": {
        "transport": "smtp",
        "smtp.host":     "adapter:env:MAIL_HOST",
        "smtp.port":     "adapter:env:MAIL_PORT",
        "smtp.username": "adapter:env:MAIL_USERNAME",
        "smtp.password": "adapter:env:MAIL_PASSWORD",
        "smtp.encryption": "adapter:env:MAIL_ENCRYPTION",
        "sender.mail":   "adapter:env:MAIL_FROM_ADDR",
        "sender.name":   "adapter:env:MAIL_FROM_NAME",
        "recipients":    "adapter:env:BACKUP_ALERT_TO",
        "send.only.on.error": "true",
        "subject": "[Snipe-IT] backup failure"
      }
    }
  ],
  "backups": [
    {
      "name": "snipeit-db",
      "source": {
        "type": "mysqldump",
        "options": {
          "host": "adapter:env:DB_HOST",
          "databases": "adapter:env:DB_DATABASE",
          "user": "adapter:env:DB_USERNAME",
          "password": "adapter:env:DB_PASSWORD",
          "singleTransaction": "true",
          "quick": "true"
        }
      },
      "target": {
        "dirname": "/backups/db",
        "filename": "snipeit-db-%Y%m%d-%H%i%s.sql",
        "compress": "gzip"
      },
      "cleanup": {
        "type": "capacity",
        "options": { "size": "5G" }
      }
    },
    {
      "name": "snipeit-uploads",
      "source": {
        "type": "tar",
        "options": {
          "path": "/snapshot/data"
        }
      },
      "target": {
        "dirname": "/backups/uploads",
        "filename": "snipeit-uploads-%Y%m%d-%H%i%s.tar",
        "compress": "gzip"
      },
      "cleanup": {
        "type": "outdated",
        "options": { "older": "30D" }
      }
    },
    {
      "name": "snipeit-storage",
      "source": {
        "type": "tar",
        "options": {
          "path": "/snapshot/storage"
        }
      },
      "target": {
        "dirname": "/backups/storage",
        "filename": "snipeit-storage-%Y%m%d-%H%i%s.tar",
        "compress": "gzip"
      },
      "cleanup": {
        "type": "outdated",
        "options": { "older": "30D" }
      }
    }
  ]
}
